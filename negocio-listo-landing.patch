@@ -0,0 +1,220 @@
+/* Negocio Listo landing — uses the site's Clash type, #FE7018 accent and pill buttons (CustomButton.css). */
+.nl-page,
+.nl-modal {
+  --nl-accent: #fe7018;
+  --nl-bg: #0a0a0a;
+  --nl-surface: #141414;
+  --nl-line: #2a2a2a;
+  --nl-text: #ffffff;
+  --nl-muted: #c9c9c9;
+  --nl-subtle: #a8a8a8;
+  color: var(--nl-text);
+  font-family: "Clash", Arial, sans-serif;
+}
+.nl-page { background: var(--nl-bg); position: relative; z-index: 1; }
+
+.nl-wrap { width: 100%; max-width: 77.5rem; margin: 0 auto; padding-inline: 1.5rem; }
+.nl-section { padding-block: 6rem; }
+.nl-accent { color: var(--nl-accent); }
+.nl-muted { color: var(--nl-muted); line-height: 1.5; margin: 0; }
+.nl-eyebrow { margin: 0; font-size: 0.875rem; font-weight: 700; letter-spacing: 0.14em; color: var(--nl-accent); text-transform: uppercase; }
+.nl-lead { margin: 0; font-size: clamp(1.125rem, 1.5vw, 1.375rem); line-height: 1.5; color: var(--nl-muted); max-width: 36rem; }
+.nl-fine { margin: 0; font-size: 0.8125rem; line-height: 1.5; color: var(--nl-subtle); }
+
+.nl-h1,
+.nl-h2 { margin: 0; font-weight: 700; text-transform: uppercase; line-height: 0.95; letter-spacing: -0.01em; }
+.nl-h1 { font-size: clamp(2.75rem, 6.2vw, 5.75rem); }
+.nl-h2 { font-size: clamp(2rem, 4vw, 3.5rem); }
+.nl-h2--xl { font-size: clamp(2.25rem, 5vw, 4.5rem); }
+
+/* Buttons: same pill system as .btn-bounce */
+.nl-btn {
+  display: inline-flex; align-items: center; justify-content: center;
+  min-height: 3.75rem; padding: 0 2rem; border: 0; border-radius: 3.75rem;
+  font: inherit; font-size: 1.0625rem; font-weight: 600; line-height: 1.1; text-align: center;
+  text-decoration: none; cursor: pointer; transition: transform 0.35s ease, opacity 0.35s ease;
+}
+.nl-btn:hover { transform: scale(0.97); }
+.nl-btn:focus-visible, .nl-lang:focus-visible, .nl-sound:focus-visible, .nl-link-btn:focus-visible,
+.nl-modal__close:focus-visible, summary:focus-visible, .nl-whatsapp__link:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
+.nl-btn[disabled] { opacity: 0.6; cursor: progress; }
+.nl-btn--primary { background: var(--nl-accent); color: #000; }
+.nl-btn--secondary { background: rgba(90, 84, 84, 0.8); color: #fff; }
+.nl-btn--dark { background: #000; color: #fff; }
+.nl-btn--block { width: 100%; }
+.nl-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
+
+/* Hero */
+.nl-hero { position: relative; overflow: hidden; border-bottom: 1px solid #1f1f1f; padding-top: 8.5rem; }
+.nl-hero__ambient { position: absolute; inset: 0; z-index: 0; }
+.nl-hero__ambient video, .nl-hero__ambient img {
+  width: 100%; height: 100%; object-fit: cover; filter: blur(48px) saturate(1.2); transform: scale(1.25); opacity: 0.35;
+}
+.nl-hero::after { content: ""; position: absolute; inset: 0; z-index: 0; background: linear-gradient(90deg, #0a0a0a 30%, rgba(10, 10, 10, 0.55) 100%); }
+.nl-hero__inner, .nl-hero__media { position: relative; z-index: 1; }
+.nl-hero {
+  display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 21rem); column-gap: 3.5rem; align-items: center;
+  padding-inline: max(1.5rem, calc((100% - 77.5rem) / 2 + 1.5rem)); padding-bottom: 5.5rem;
+}
+.nl-hero__inner { padding: 0; max-width: none; grid-column: 1; grid-row: 1; }
+.nl-hero__media { grid-column: 2; grid-row: 1; display: flex; flex-direction: column; gap: 0.75rem; }
+.nl-hero__copy { display: flex; flex-direction: column; gap: 1.5rem; }
+.nl-hero__top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
+.nl-lang {
+  display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0 1rem; border: 1px solid #3a3a3a;
+  border-radius: 999px; color: #fff; font-size: 0.875rem; font-weight: 600; text-decoration: none;
+}
+.nl-lang:hover { border-color: var(--nl-accent); }
+.nl-from { margin: 0.5rem 0 0; display: flex; align-items: baseline; gap: 0.5rem; }
+.nl-from__label { font-size: 0.875rem; font-weight: 700; letter-spacing: 0.12em; color: var(--nl-subtle); text-transform: uppercase; }
+.nl-from__price { font-size: 3.5rem; font-weight: 700; line-height: 1; }
+.nl-from__per { font-size: 1.25rem; color: var(--nl-muted); }
+
+.nl-phone {
+  position: relative; width: 100%; aspect-ratio: 9 / 16; padding: 0.625rem; border-radius: 2.25rem;
+  background: #1a1a1a; border: 1px solid #333; box-shadow: 0 40px 80px rgba(0, 0, 0, 0.6);
+}
+.nl-phone video { display: block; width: 100%; height: 100%; object-fit: cover; border-radius: 1.75rem; background: #000; }
+.nl-sound {
+  position: absolute; left: 50%; bottom: 1.75rem; transform: translateX(-50%);
+  display: inline-flex; align-items: center; gap: 0.5rem; min-height: 2.75rem; padding: 0 1.125rem;
+  border: 0; border-radius: 999px; background: rgba(0, 0, 0, 0.78); color: #fff;
+  font: inherit; font-size: 0.875rem; font-weight: 600; white-space: nowrap; cursor: pointer;
+}
+.nl-transcript summary { cursor: pointer; color: var(--nl-subtle); font-size: 0.875rem; min-height: 2.75rem; display: flex; align-items: center; justify-content: center; }
+.nl-transcript p { margin: 0.25rem 0 0; font-size: 0.9375rem; line-height: 1.55; color: var(--nl-muted); }
+
+/* Problem */
+.nl-split { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 1.5rem; margin-bottom: 3rem; }
+.nl-split .nl-h2 { max-width: 46rem; }
+.nl-split__aside { max-width: 24rem; font-size: 1.125rem; }
+.nl-cards, .nl-steps, .nl-plan__features { list-style: none; margin: 0; padding: 0; }
+.nl-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }
+.nl-card { padding: 2rem; border-radius: 1.25rem; background: var(--nl-surface); border: 1px solid #262626; display: flex; flex-direction: column; gap: 0.875rem; }
+.nl-card__title { margin: 0; font-size: 1.5rem; font-weight: 700; }
+.nl-check { width: 2.75rem; height: 2.75rem; border-radius: 50%; background: var(--nl-accent); color: #000; display: inline-flex; align-items: center; justify-content: center; }
+.nl-check--lg { width: 3.5rem; height: 3.5rem; }
+
+/* Band */
+/* Section backgrounds use `nl-bg-*` classes: index.css forces `main section:not([class*="bg-"])` transparent. */
+.nl-band { background: var(--nl-accent); color: #000; }
+.nl-band__inner { padding-block: 3.5rem; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.5rem; }
+.nl-band__title { color: #000; margin: 0; font-size: clamp(1.875rem, 4vw, 3.375rem); font-weight: 700; line-height: 1; text-transform: uppercase; max-width: 42rem; }
+.nl-band__body { color: #000; margin: 0; font-size: 1.1875rem; line-height: 1.5; font-weight: 500; max-width: 27rem; }
+
+/* Plans */
+#planes .nl-h2 { margin: 0.875rem 0 3rem; }
+.nl-plans { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; align-items: stretch; }
+.nl-plan {
+  position: relative; padding: 2.5rem 2rem 2rem; border-radius: 1.25rem; background: var(--nl-surface);
+  border: 1px solid #2e2e2e; display: flex; flex-direction: column; gap: 1.125rem;
+}
+.nl-plan--popular { background: var(--nl-accent); color: #000; border-color: var(--nl-accent); }
+.nl-plan__badge { position: absolute; top: -0.875rem; left: 2rem; padding: 0.375rem 0.75rem; border-radius: 0.375rem; background: #fff; color: #000; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em; }
+.nl-plan__name { margin: 0; font-size: 1.625rem; font-weight: 700; }
+.nl-plan__price { margin: 0; font-size: 1.25rem; color: var(--nl-muted); }
+.nl-plan__price span { font-size: 4rem; font-weight: 700; line-height: 1; color: inherit; margin-right: 0.25rem; }
+.nl-plan:not(.nl-plan--popular) .nl-plan__price span { color: #fff; }
+.nl-plan--popular .nl-plan__price { color: #000; }
+.nl-plan__tagline { margin: 0; padding-bottom: 1.125rem; border-bottom: 1px solid #2e2e2e; font-size: 1.125rem; font-weight: 700; color: var(--nl-accent); }
+.nl-plan--popular .nl-plan__tagline { color: #000; border-color: rgba(0, 0, 0, 0.25); }
+.nl-plan__features { display: flex; flex-direction: column; gap: 0.75rem; flex-grow: 1; }
+.nl-plan__features li { position: relative; padding-left: 1.25rem; font-size: 1rem; line-height: 1.4; color: #d4d4d4; }
+.nl-plan__features li::before { content: ""; position: absolute; left: 0; top: 0.45em; width: 0.5rem; height: 0.5rem; background: var(--nl-accent); }
+.nl-plan--popular .nl-plan__features li { color: #000; }
+.nl-plan--popular .nl-plan__features li::before { background: #000; }
+.nl-addon { margin-top: 1.25rem; padding: 1.5rem 2rem; border-radius: 1.25rem; border: 1px dashed #3a3a3a; display: grid; grid-template-columns: auto auto 1fr; align-items: center; gap: 0.5rem 1.5rem; }
+.nl-addon__label { margin: 0; font-size: 0.875rem; font-weight: 700; letter-spacing: 0.12em; }
+.nl-addon__name { margin: 0; font-size: 1.5rem; font-weight: 700; }
+.nl-plans__fine { margin-top: 1rem; }
+
+/* How */
+.nl-how { background: #0f0f0f; border-block: 1px solid #1f1f1f; }
+.nl-how .nl-h2 { margin-bottom: 2.5rem; }
+.nl-steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; }
+.nl-step { display: flex; flex-direction: column; gap: 0.625rem; }
+.nl-step__n { font-size: 4.5rem; font-weight: 700; line-height: 1; color: var(--nl-accent); }
+
+/* Form */
+.nl-form-section { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: 3.5rem; align-items: start; }
+.nl-form-section__intro { display: flex; flex-direction: column; gap: 1.25rem; }
+.nl-whatsapp { margin-top: 1rem; padding: 1.5rem; border-radius: 1rem; border: 1px solid #2e2e2e; display: flex; flex-direction: column; gap: 0.5rem; }
+.nl-whatsapp__link { display: flex; flex-direction: column; gap: 0.25rem; color: #fff; text-decoration: none; font-size: 1.125rem; font-weight: 600; }
+.nl-whatsapp__link span { font-size: 1.625rem; font-weight: 700; color: var(--nl-accent); }
+.nl-whatsapp__link:hover span { color: #fff; }
+.nl-form-card { padding: 2.25rem; border-radius: 1.5rem; background: var(--nl-surface); border: 1px solid #2e2e2e; }
+.nl-form { display: flex; flex-direction: column; gap: 1.125rem; }
+.nl-form__row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.125rem; }
+.nl-form__stack { display: flex; flex-direction: column; gap: 0.875rem; }
+.nl-field { display: flex; flex-direction: column; gap: 0.5rem; min-width: 0; }
+.nl-field label, .nl-fieldset legend { font-size: 0.9375rem; font-weight: 600; }
+.nl-input {
+  width: 100%; min-height: 3rem; padding: 0.75rem 0.875rem; border-radius: 0.75rem; border: 1px solid #3a3a3a;
+  background: #1a1a1a; color: #fff; font: inherit; font-size: 1rem;
+}
+.nl-input:focus { outline: 2px solid var(--nl-accent); outline-offset: 1px; border-color: var(--nl-accent); }
+select.nl-input { appearance: auto; }
+.nl-fieldset { border: 0; padding: 0; margin: 0; }
+.nl-fieldset legend { margin-bottom: 0.5rem; }
+.nl-radios { display: flex; gap: 1.5rem; }
+.nl-radio { display: inline-flex; align-items: center; gap: 0.5rem; min-height: 2.75rem; cursor: pointer; }
+.nl-radio input { width: 1.25rem; height: 1.25rem; accent-color: var(--nl-accent); }
+.nl-form__error { margin: 0; color: #ffb38a; font-size: 0.9375rem; }
+.nl-hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
+.nl-form-done { display: flex; flex-direction: column; align-items: flex-start; gap: 0.875rem; padding: 2rem 0.5rem; }
+.nl-form-done__title { margin: 0; font-size: 2rem; font-weight: 700; }
+
+/* FAQ */
+.nl-faq { padding-top: 0; }
+.nl-faq .nl-h2 { margin-bottom: 2rem; }
+.nl-faq__list { display: flex; flex-direction: column; border-top: 1px solid var(--nl-line); }
+.nl-faq__item { border-bottom: 1px solid var(--nl-line); }
+.nl-faq__item summary { cursor: pointer; padding: 1.25rem 0; font-size: 1.25rem; font-weight: 600; list-style: none; display: flex; justify-content: space-between; gap: 1rem; }
+.nl-faq__item summary::-webkit-details-marker { display: none; }
+.nl-faq__item summary::after { content: "+"; color: var(--nl-accent); font-size: 1.5rem; line-height: 1; }
+.nl-faq__item[open] summary::after { content: "–"; }
+.nl-faq__item p { padding-bottom: 1.25rem; max-width: 48rem; }
+
+/* Popup / bottom sheet */
+.nl-modal { position: fixed; inset: 0; z-index: 10000; display: flex; align-items: center; justify-content: center; padding: 1.5rem; }
+.nl-modal__backdrop { position: absolute; inset: 0; background: rgba(0, 0, 0, 0.72); backdrop-filter: blur(4px); }
+.nl-modal__card {
+  position: relative; width: 100%; max-width: 28.75rem; max-height: calc(100dvh - 3rem); overflow-y: auto;
+  padding: 2rem; border-radius: 1.5rem; background: var(--nl-surface); border: 1px solid #333;
+  box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6); animation: nl-pop 0.3s ease;
+}
+.nl-modal__grip { display: none; }
+.nl-modal__close { position: absolute; top: 0.75rem; right: 0.75rem; width: 2.75rem; height: 2.75rem; border: 0; border-radius: 50%; background: transparent; color: var(--nl-muted); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }
+.nl-modal__close:hover { background: #222; color: #fff; }
+.nl-modal__title { margin: 0.625rem 0 0.5rem; padding-right: 2rem; font-size: 2rem; line-height: 1.05; font-weight: 700; }
+.nl-modal__sub { margin-bottom: 1.375rem; }
+.nl-modal__done { display: flex; flex-direction: column; gap: 0.75rem; padding-top: 1rem; }
+.nl-link-btn { display: block; width: 100%; min-height: 2.75rem; margin-top: 0.5rem; border: 0; background: transparent; color: var(--nl-subtle); font: inherit; font-size: 0.9375rem; text-decoration: underline; cursor: pointer; }
+@keyframes nl-pop { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
+
+@media (prefers-reduced-motion: reduce) {
+  .nl-modal__card { animation: none; }
+  .nl-btn { transition: none; }
+}
+
+@media (max-width: 991px) {
+  .nl-hero { grid-template-columns: minmax(0, 1fr); padding-top: 6.5rem; row-gap: 3rem; }
+  .nl-hero__media { grid-column: 1; grid-row: 2; width: 100%; max-width: 21rem; margin: 0 auto; }
+  .nl-cards, .nl-plans, .nl-steps { grid-template-columns: minmax(0, 1fr); }
+  .nl-plans { gap: 2rem; }
+  .nl-form-section { grid-template-columns: minmax(0, 1fr); }
+  .nl-addon { grid-template-columns: minmax(0, 1fr); }
+}
+
+@media (max-width: 640px) {
+  .nl-section { padding-block: 4.5rem; }
+  .nl-hero::after { background: linear-gradient(180deg, rgba(10, 10, 10, 0.6) 0%, #0a0a0a 100%); }
+  .nl-actions .nl-btn { width: 100%; }
+  .nl-form__row { grid-template-columns: minmax(0, 1fr); }
+  .nl-form-card { padding: 1.5rem; }
+  .nl-modal { align-items: flex-end; padding: 0; }
+  .nl-modal__card { max-width: 100%; max-height: 88dvh; border-radius: 1.5rem 1.5rem 0 0; padding: 0.75rem 1.25rem 1.75rem; animation-name: nl-sheet; }
+  .nl-modal__grip { display: block; width: 2.5rem; height: 0.25rem; margin: 0 auto 0.75rem; border-radius: 2px; background: #4a4a4a; }
+  .nl-modal__title { font-size: 1.625rem; }
+  @keyframes nl-sheet { from { transform: translateY(100%); } to { transform: none; } }
+}
