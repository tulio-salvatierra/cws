# Cicero Web Studio environment variables
#
# Local development:
#   npm run env:setup    # copies this file to .env (if missing)
#   Fill in values, then: npm run env:check
#
# Vercel (required for production builds):
#   Pull:  npm run env:pull
#   Push:  Vercel dashboard → Project Settings → Environment Variables → Import .env
#   VITE_* vars must be enabled for Production (they are baked in at build time)
#
# Security:
#   - Never commit real secrets here — use placeholders only
#   - Never prefix secrets with VITE_ (those are bundled into the browser)
#   - RESEND_API_KEY, GOOGLE_SHEETS_WEBHOOK_SECRET, OPENAI_API_KEY,
#     GENERATION_SUPABASE_SERVICE_ROLE_KEY, PUBLISHED_SUPABASE_SERVICE_ROLE_KEY,
#     PUBLISHED_WEBHOOK_SECRET, and GOOGLE_PLACES_API_KEY stay server-side only

# --- Client (VITE_ = exposed to browser; safe for anon keys only) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_CLIENT_PORTAL_INTAKE_WEBHOOK_URL=/api/client-portal-intake
VITE_CLIENT_PORTAL_UPDATE_WEBHOOK_URL=/api/client-portal-intake

# Optional Maps JavaScript API (browser key — restrict HTTP referrers in Google Cloud)
# APIs: Maps JavaScript API only. Create a Map ID for Advanced Markers in production.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=

# --- Server only (API routes on Vercel + local dev middleware) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=Your Name <you@yourdomain.com>

# --- Non-publishing AI draft generation ---
OPENAI_API_KEY=
OPENAI_GENERATION_MODEL=gpt-5.6-sol
GENERATION_SUPABASE_URL=https://your-project.supabase.co
GENERATION_SUPABASE_SERVICE_ROLE_KEY=

# --- Google Sheets sync ---
GOOGLE_SHEETS_WEBHOOK_SECRET=
GOOGLE_SHEETS_WEBHOOK_URL=

# --- Sales S2A Google Places discovery (server-side only; never VITE_) ---
GOOGLE_PLACES_API_KEY=

# --- Authenticated publishing return path ---
PUBLISHED_SUPABASE_URL=https://your-project.supabase.co
PUBLISHED_SUPABASE_SERVICE_ROLE_KEY=
PUBLISHED_WEBHOOK_SECRET=
PUBLISHED_WORKSPACE_ID=

# --- Marketing V1 bundle.social provider (server-side only) ---
# Configure these only in Vercel or a local untracked .env file.
BUNDLE_SOCIAL_API_KEY=your-bundle-social-api-key
BUNDLE_SOCIAL_TEAM_ID=your-bundle-social-team-id
