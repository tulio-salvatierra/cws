{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/laya-assess.js": {
      "maxDuration": 60
    },
    "api/marketing-creative.js": {
      "maxDuration": 60
    },
    "api/client-portal-intake.js": {
      "maxDuration": 60,
      "includeFiles": "src/content/intake/**"
    },
    "api/marketing-linkedin.js": {
      "maxDuration": 30,
      "includeFiles": "public/images/logo.png"
    },
    "api/sales.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/command-queue",
      "destination": "/api/sales"
    },
    {
      "source": "/api/intake",
      "destination": "/api/client-portal-intake?intake=1"
    },
    {
      "source": "/intake/:slug([a-z][a-z0-9-]*)",
      "destination": "/intake/:slug.html"
    },
    {
      "source": "/api/outreach/webhook",
      "destination": "/api/outreach-webhook"
    },
    {
      "source": "/api/outreach/:path*",
      "destination": "/api/outreach"
    },
    {
      "source": "/negocio-listo",
      "destination": "/negocio-listo.html"
    },
    {
      "source": "/en/negocio-listo",
      "destination": "/en/negocio-listo.html"
    },
    {
      "source": "/review/:path*",
      "destination": "https://cws-review.vercel.app/:path*"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/services",
      "destination": "/services.html"
    },
    {
      "source": "/chicago-web-design",
      "destination": "/chicago-web-design.html"
    },
    {
      "source": "/blog",
      "destination": "/blog.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/policy",
      "destination": "/policy.html"
    },
    {
      "source": "/blog/website-design-services-chicago-small-business",
      "destination": "/blog/website-design-services-chicago-small-business.html"
    },
    {
      "source": "/blog/custom-website-vs-template-small-business",
      "destination": "/blog/custom-website-vs-template-small-business.html"
    },
    {
      "source": "/blog/small-business-website-checklist-chicago",
      "destination": "/blog/small-business-website-checklist-chicago.html"
    },
    {
      "source": "/blog/choose-website-designer-chicago",
      "destination": "/blog/choose-website-designer-chicago.html"
    },
    {
      "source": "/blog/website-refresh-vs-redesign-small-business",
      "destination": "/blog/website-refresh-vs-redesign-small-business.html"
    },
    {
      "source": "/landing/cicero-web-design",
      "destination": "/landing/cicero-web-design.html"
    },
    {
      "source": "/landing/chicago-digital-marketing",
      "destination": "/landing/chicago-digital-marketing.html"
    },
    {
      "source": "/landing/berwyn-ecommerce",
      "destination": "/landing/berwyn-ecommerce.html"
    },
    {
      "source": "/landing/oak-park-seo",
      "destination": "/landing/oak-park-seo.html"
    },
    {
      "source": "/landing/elmwood-park-maintenance",
      "destination": "/landing/elmwood-park-maintenance.html"
    },
    {
      "source": "/landing/website-refresh-redesign",
      "destination": "/landing/website-refresh-redesign.html"
    },
    {
      "source": "/",
      "destination": "/home.html"
    },
    {
      "source": "/((?!intake(?:/|$)|api/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/intake/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/intake",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
