{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/client-portal-intake.js": {
      "maxDuration": 60
    },
    "api/generate-draft.js": {
      "maxDuration": 60
    },
    "api/review-generated-draft.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
