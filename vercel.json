{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/client-portal-intake.js": {
      "maxDuration": 60
    },
    "api/generate-draft.js": {
      "maxDuration": 60
    },
    "api/review-generated-draft.js": {
      "maxDuration": 30
    },
    "api/n8n-dry-run.js": {
      "maxDuration": 30
    },
    "api/publish-linkedin.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/outreach/webhook",
      "destination": "/api/outreach-webhook"
    },
    {
      "source": "/api/outreach/:path*",
      "destination": "/api/outreach"
    },
    {
      "source": "/((?!api/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
